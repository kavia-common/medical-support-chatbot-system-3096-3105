# Backend configuration for CrewAI Medical Support (FastAPI)

# Container/service name
PROJECT_NAME=medical_chatbot_backend

# CORS origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Embedding model settings (demo/mock)
EMBEDDING_MODEL=mock-embedder
VECTOR_DIM=384

