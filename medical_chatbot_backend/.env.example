# Project settings
PROJECT_NAME=medical_chatbot_backend

# CORS: comma-separated list of allowed origins for the FastAPI backend.
# Include localhost for local dev and the cloud preview origin for proxy/preview access.
# You can add multiple origins separated by commas.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://vscode-internal-30348-beta.beta01.cloud.kavia.ai:4000

# Embeddings / Vector settings (demo)
EMBEDDING_MODEL=mock-embedder
VECTOR_DIM=384

# Optional: persist store (demo uses in-memory)
USE_PERSISTENT_STORE=false
