# PUBLIC: Example environment variables for the Medical Chatbot Frontend
# Copy this file to `.env` and adjust values as needed for your environment.

# PUBLIC_INTERFACE
# Base URL of the FastAPI backend (no trailing slash). Example: http://localhost:8000 or https://api.example.com
REACT_APP_API_BASE_URL=http://localhost:8000

# PUBLIC_INTERFACE
# Optional: Override the site URL used for auth redirects if needed by the backend
REACT_APP_SITE_URL=http://localhost:3000
